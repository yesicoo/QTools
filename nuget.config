<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    项目级 NuGet 配置：中央包管理（CPM）要求在多包源环境下显式声明包源映射。
    只依赖公共源，行为确定、可复现；如遇网络问题可调整顺序或增删源。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="QingNuget" value="https://nuget.yesicoo.com/v3/index.json" allowInsecureConnections="True" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="QingNuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
